# Root level - ignore everything except client and server directories
node_modules/
package-lock.json
.env
.env.local

# Admin credentials (bcrypt hash) - never commit, bootstrap via
# ADMIN_EMAIL/ADMIN_PASSWORD env vars or `npm run set-admin` instead
server/data/admin.json

# Admin-uploaded images - runtime data, not source
server/data/uploads/

# Documentation (keep these)
# !README.md
# !ADMIN_QUICK_START.md
# !ADMIN_SYSTEM_README.md
# !CONTACT_FORM_SETUP.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
